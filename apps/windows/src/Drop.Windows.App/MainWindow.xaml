<Window x:Class="Drop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drop" Height="650" Width="720" MinHeight="560" MinWidth="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="30" FontWeight="SemiBold" Text="Drop" />
        <StackPanel Grid.Row="1" Margin="0,6,0,16">
            <TextBlock FontSize="18" Text="Nearby devices" />
            <TextBlock x:Name="DiscoveryStatusText" Margin="0,4,0,0" Foreground="DimGray"
                       Text="Looking for devices…" />
        </StackPanel>

        <ListBox x:Name="DeviceList" Grid.Row="2" SelectionChanged="DeviceList_SelectionChanged"
                 HorizontalContentAlignment="Stretch" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding DeviceName}" />
                            <TextBlock Margin="0,3,0,0" Foreground="DimGray" Text="{Binding Platform}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="ForestGreen"
                                   Text="Available" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Margin="0,16,0,0" Padding="14" Background="#FFFFF4D6" CornerRadius="6"
                Visibility="{Binding Incoming.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Incoming.StatusText}" />
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="From " /><Run FontWeight="SemiBold" Text="{Binding Incoming.SenderName}" />
                    </TextBlock>
                    <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding Incoming.FileName}" />
                    <ProgressBar Margin="0,9,0,0" Height="8" Minimum="0" Maximum="100"
                                 Value="{Binding Incoming.ProgressPercent}" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="DimGray"
                               Text="{Binding Incoming.ProgressText}" />
                </StackPanel>
                <Button Grid.Column="1" Margin="0,0,8,0" Padding="16,8" Content="Decline"
                        Click="DeclineIncomingButton_Click" IsEnabled="{Binding Incoming.CanDecide}"
                        Visibility="{Binding Incoming.CanDecide, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Grid.Column="2" Padding="18,8" Content="Accept"
                        Click="AcceptIncomingButton_Click" IsEnabled="{Binding Incoming.CanDecide}"
                        Visibility="{Binding Incoming.CanDecide, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Margin="0,16,0,0" Padding="14" Background="#FFF4F4F4" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Transfer.FileName}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding Transfer.StatusText}" />
                    <ProgressBar Margin="0,9,0,0" Height="8" Minimum="0" Maximum="100"
                                 Value="{Binding Transfer.ProgressPercent}" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="DimGray"
                               Text="{Binding Transfer.ProgressText}" />
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="1" Margin="0,0,8,0" Padding="16,8"
                        Content="Cancel" Click="CancelButton_Click" IsEnabled="False" />
                <Button x:Name="SendButton" Grid.Column="2" Padding="18,8"
                        Content="Send file" Click="SendButton_Click" IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
